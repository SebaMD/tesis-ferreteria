# PostgreSQL usado por Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_DB=ferreteria
POSTGRES_HOST_PORT=5433

# Backend dentro de Docker
# El proxy interno del frontend espera el backend en el puerto 3000.
PORT=3000
JWT_SECRET=cambiar_por_un_secreto_largo
COOKIE_KEY=cambiar_por_un_secreto_largo

# Webpay Plus en ambiente de integracion
WEBPAY_ENVIRONMENT=integration
# En integration se usan automaticamente las credenciales oficiales incluidas en el SDK.
# Estas variables son obligatorias solamente al cambiar a WEBPAY_ENVIRONMENT=production.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL=http://localhost:3000/api/online-orders/payments/webpay/return
FRONTEND_URL=http://localhost:5173
WEBPAY_TIMEOUT_MS=30000
ONLINE_ORDER_RESERVATION_MINUTES=20

# Correo SMTP opcional. Para Mailpit dentro de Docker puede utilizar SMTP_HOST=mailpit.
MAIL_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FERRETERIA FYF <no-reply@fyf.local>"

# Configuracion opcional del entorno Docker
NODE_ENV=production
SEED_DEMO_DATA=true
