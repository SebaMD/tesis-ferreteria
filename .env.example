# PostgreSQL usado por Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_DB=ferreteria
POSTGRES_HOST_PORT=5433

# Backend dentro de Docker
# El proxy interno del frontend espera el backend en el puerto 3000.
PORT=3000
JWT_SECRET=cambiar_por_un_secreto_largo
COOKIE_KEY=cambiar_por_un_secreto_largo

# Configuracion opcional del entorno Docker
NODE_ENV=production
SEED_DEMO_DATA=true
