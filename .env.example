# Copiar a .env en la raiz para Docker Compose y reemplazar los placeholders.
# PostgreSQL usado por Docker Compose (no utilizar estas claves en produccion).
# Compose construye DATABASE_URL para migrar/seed: usar usuario, clave y nombre
# de base compatibles con una URI (una clave aleatoria hexadecimal evita caracteres reservados).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_DB=ferreteria
POSTGRES_HOST_PORT=5433

# Puerto publicado del backend. Dentro de Docker siempre escucha en 3000.
# Si cambia PORT, actualizar tambien WEBPAY_RETURN_URL para el acceso externo.
PORT=3000
JWT_SECRET=cambiar_por_un_secreto_largo
# Secreto independiente para firmar los PIN de correo (minimo exigido: 32 caracteres).
EMAIL_VERIFICATION_SECRET=cambiar_por_otro_secreto_largo_e_independiente
# Secreto independiente para firmar los QR de traspaso logistico (minimo: 32 caracteres aleatorios).
LOGISTICS_QR_SECRET=cambiar_por_un_secreto_logistico_largo_e_independiente

# Webpay Plus en ambiente de integracion
WEBPAY_ENVIRONMENT=integration
# En integration se usan automaticamente las credenciales oficiales incluidas en el SDK.
# Estas variables son obligatorias solamente al cambiar a WEBPAY_ENVIRONMENT=production.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL=http://localhost:3000/api/online-orders/payments/webpay/return
FRONTEND_URL=http://localhost:5173
WEBPAY_TIMEOUT_MS=30000
ONLINE_ORDER_RESERVATION_MINUTES=20
GUEST_ORDER_ACCESS_DAYS=180

# MAIL_ENABLED=false omite correos informativos e impide los flujos que necesitan
# codigos/enlaces: verificacion, recuperacion y reactivacion. No es un modo completo de ecommerce.
# Configurar un servidor SMTP accesible; Compose no incluye un servicio Mailpit.
# Si SMTP esta en el host con Docker Desktop, puede usar host.docker.internal.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# API y uploads pasan por Nginx. Variable publica de compilacion, nunca un secreto.
VITE_API_URL=/api

# Para la prueba HTTP local; usar production y HTTPS en un despliegue real.
# NODE_ENV controla, entre otras cosas, la cookie Secure del dispositivo Invitado.
NODE_ENV=development
# Solo habilitar sobre una base descartable. El seed incluye datos historicos demo.
SEED_DEMO_DATA=false
