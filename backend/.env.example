# Copiar a backend/.env y reemplazar los placeholders.
# Conexion preferida del backend y obligatoria para Drizzle Kit.
# Codificar caracteres reservados de usuario/clave como componentes de URI.
# Si usa el PostgreSQL publicado por Compose, cambiar localhost:5432 por localhost:5433.
DATABASE_URL=postgresql://postgres:cambiar_por_una_clave_segura@localhost:5432/ferreteria

PORT=3000
# Usar production en despliegues HTTPS. En local HTTP dejar development.
NODE_ENV=development
# Directorio persistente opcional para imagenes y evidencias (por defecto: backend/uploads).
# En Docker Compose se utiliza /app/uploads mediante el volumen product_uploads.
# Con PM2 se recomienda una ruta absoluta para que el resultado no dependa de su cwd.
# UPLOADS_ROOT=/ruta/absoluta/tesis-ferreteria/backend/uploads
JWT_SECRET=cambiar_por_un_secreto_largo
# SESSION_SECRET es un alias legado que tiene prioridad sobre JWT_SECRET; no configurar ambos.
# COOKIE_KEY se lee como configuracion legada, pero actualmente no tiene consumidores.
# COOKIE_KEY=
# Secreto independiente para firmar los PIN de correo (minimo exigido: 32 caracteres).
EMAIL_VERIFICATION_SECRET=cambiar_por_otro_secreto_largo_e_independiente
# Secreto independiente para firmar los QR de traspaso logistico (minimo: 32 caracteres aleatorios).
LOGISTICS_QR_SECRET=cambiar_por_un_secreto_logistico_largo_e_independiente

# Webpay Plus. Integracion usa las credenciales oficiales incluidas en el SDK;
# produccion requiere completar las variables comerciales reales.
WEBPAY_ENVIRONMENT=integration
# En integration se usan automaticamente las credenciales oficiales incluidas en el SDK.
# Estas variables son obligatorias solamente al cambiar a WEBPAY_ENVIRONMENT=production.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL=http://localhost:3000/api/online-orders/payments/webpay/return
FRONTEND_URL=http://localhost:5173
WEBPAY_TIMEOUT_MS=30000
ONLINE_ORDER_RESERVATION_MINUTES=20
GUEST_ORDER_ACCESS_DAYS=180

# MAIL_ENABLED=false omite correos informativos e impide los flujos que necesitan
# codigos/enlaces: verificacion, recuperacion y reactivacion. No es un modo completo de ecommerce.
# Puerto 587 normalmente usa STARTTLS con SMTP_SECURE=false.
# Puerto 465 normalmente usa TLS directo con SMTP_SECURE=true.
# SMTP_USER/SMTP_PASS dependen del proveedor y deben configurarse juntos cuando exige autenticacion.
# MAIL_FROM acepta "Nombre visible <correo@dominio.cl>" o solamente correo@dominio.cl.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Alternativa del backend cuando DATABASE_URL no esta definida.
# Drizzle Kit sigue requiriendo DATABASE_URL para migraciones.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=cambiar_por_una_clave_segura
# DATABASE=ferreteria
