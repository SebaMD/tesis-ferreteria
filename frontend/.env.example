# Unica variable VITE_* utilizada. Es publica y se incorpora durante el build.
# Desarrollo local: /api usa el proxy de Vite a localhost:3000.
# Docker/mismo origen: /api usa el proxy Nginx al servicio backend:3000.
# Origen distinto: usar la URL publica absoluta del backend terminada en /api.
# No colocar secretos aqui. Cambiarla requiere reconstruir el frontend.
VITE_API_URL=/api
